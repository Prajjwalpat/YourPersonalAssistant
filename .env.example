# Ollama serves its local API on this address by default.
OLLAMA_BASE_URL=http://localhost:11434

# Small general-purpose chat model. Change this to any model you have pulled.
OLLAMA_CHAT_MODEL=llama3.2:3b

# Embedding model used to build and query the FAISS vector index.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional Docker host port; native run.ps1 continues to use 8501.
CHATDOC_PORT=8502
